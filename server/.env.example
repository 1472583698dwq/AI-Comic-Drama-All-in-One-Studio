# MiniMax AI 漫剧 Studio 环境配置
# 复制本文件为 .env 并填入真实密钥后重启后端服务

# MiniMax API（必填：剧本拆解 LLM 与 TTS 配音均依赖此密钥）
# 申请地址: https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 模型
LLM_MODEL=abab6.5s-chat
TTS_MODEL=speech-01-turbo
VIDEO_MODEL=video-01

# ComfyUI 生图服务（默认本机 8188；生图功能依赖 ComfyUI 在线）
COMFYUI_SERVER_URL=http://127.0.0.1:8188
# 留空则自动选择 ComfyUI 中第一个 SDXL/illustrious checkpoint
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT_SECONDS=240

# ---- 默认视频生成源（全部缺 Key 即禁用，配置 Key 后即用）----
# MiniMax H3: https://platform.minimax.io/docs/guides/video-generation
# 复用 MINIMAX_API_KEY，按量计费 API 才能调用 H3
MINIMAX_H3_MODEL=MiniMax-H3
MINIMAX_H3_BASE_URL=https://api.minimax.chat

# Seedance (火山引擎 Ark): https://www.volcengine.com/product/ark
# 模型如 doubao-seedance-2-0-260128 / doubao-seedance-2-0-fast-260128 / doubao-seedance-2-5-260628
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# 可灵 Kling (快手): https://klingai.com / https://app.klingai.com/cn/dev/document-api
# 模型如 kling-v3 / kling-v2-6 / kling-video-o1；官方为 AK/SK 签发 JWT，本项目支持 Bearer 直连或中转网关，BASE_URL 可指向中转
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v3

# 万相 Wan3.0 (阿里百炼 DashScope): https://help.aliyun.com/zh/model-studio/wan3-video-generation-api-reference
# 复用 DASHSCOPE_API_KEY；模型 wan3.0-video(标准) / wan3.0-video-prime(高速)
DASHSCOPE_API_KEY=
WAN3_MODEL=wan3.0-video
WAN3_BASE_URL=https://dashscope.aliyuncs.com
