# MiniMax AI 漫剧 Studio 环境配置
# 复制本文件为 .env 并填入真实密钥后重启后端服务

# MiniMax API（必填：剧本拆解 LLM 与 TTS 配音均依赖此密钥）
# 申请地址: https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 模型
LLM_MODEL=abab6.5s-chat
TTS_MODEL=speech-01-turbo
VIDEO_MODEL=video-01

# ComfyUI 生图服务（默认本机 8188；生图功能依赖 ComfyUI 在线）
COMFYUI_SERVER_URL=http://127.0.0.1:8188
# 留空则自动选择 ComfyUI 中第一个 SDXL/illustrious checkpoint
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT_SECONDS=1200

# ---- 默认视频生成源（全部缺 Key 即禁用，配置 Key 后即用）----
# MiniMax H3: https://platform.minimax.io/docs/guides/video-generation
# 复用 MINIMAX_API_KEY，按量计费 API 才能调用 H3
MINIMAX_H3_MODEL=MiniMax-H3
MINIMAX_H3_BASE_URL=https://api.minimax.chat

# Seedance (火山引擎 Ark): https://www.volcengine.com/product/ark
# 模型如 doubao-seedance-2-0-260128 / doubao-seedance-2-0-fast-260128 / doubao-seedance-2-5-260628
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# 可灵 Kling (快手): https://klingai.com / https://app.klingai.com/cn/dev/document-api
# 模型如 kling-v3 / kling-v2-6 / kling-video-o1；官方为 AK/SK 签发 JWT，本项目支持 Bearer 直连或中转网关，BASE_URL 可指向中转
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v3

# 万相 Wan3.0 (阿里百炼 DashScope): https://help.aliyun.com/zh/model-studio/wan3-video-generation-api-reference
# 复用 DASHSCOPE_API_KEY；模型 wan3.0-video(标准) / wan3.0-video-prime(高速)
DASHSCOPE_API_KEY=
WAN3_MODEL=wan3.0-video
WAN3_BASE_URL=https://dashscope.aliyuncs.com

# ---- 导演 Agent 内核（v2 事件溯源状态机；出问题可设 v1 回退旧 LangChain 引擎）----
AGENT_ENGINE=v2
# 轮次安全上限（防死循环，正常不需要改）
AGENT_MAX_ITERATIONS=200
# 单次模型调用超时/重试次数/最大输出 tokens
AGENT_LLM_TIMEOUT=300
AGENT_LLM_RETRIES=2
AGENT_MAX_TOKENS=8192
# 工具执行超时（秒；视频类固定 1800）
AGENT_TOOL_TIMEOUT_S=900
# 审批等待超时（秒；无交互通道时一律 fail-closed 拒绝）
AGENT_APPROVAL_TIMEOUT=120
# 上下文窗口与压缩保留比例
AGENT_CONTEXT_WINDOW=65536
AGENT_COMPACT_KEEP_RATIO=0.2
# 后台任务并发上限
AGENT_MAX_JOBS=4
# 子代理深度与超时
AGENT_SUBAGENT_MAX_DEPTH=1
AGENT_SUBAGENT_TIMEOUT=600

# ---- Agent 多模态（输入框附件：图/视频/音频）----
# 图片是否内联为 image_url 发给主模型：auto=按模型名探测 / 1=强制开 / 0=强制关（关闭时降级为文本+URL）
AGENT_MM_IMAGE=auto
# 视频/音频默认不内联（多数 chat 接口不收 video part）；打开后按 content part 发送
AGENT_MM_VIDEO=0
AGENT_MM_AUDIO=0
# 附件内联上限（字节，默认 8MB；超限降级为文本说明）
AGENT_MM_MAX_BYTES=8388608
# 画布「加入会话」节点的已有产出 → 自动作为媒体附件给模型看（1/0）
AGENT_FOCUS_MEDIA=1
# 生成类工具产物 → 自动回投给模型看（1/0）
AGENT_TOOL_MEDIA=1
# 用户长文本粘贴（> 该字符数）在模型历史里折叠为 头+尾+落盘定位符（全文可 fs_read）
AGENT_USER_TEXT_MAX=6000

# ---- 异步生成任务中心（TaskCenter：提交→轮询→落盘 统一抽象）----
# provider 视频工具默认阻塞等待成片的时长（秒）；任务不会丢，超时可 task_wait 续等
AGENT_VIDEO_WAIT_S=1200
# 轮询间隔（秒）与任务总超时（秒）
STUDIO_TASK_POLL_INTERVAL=5
STUDIO_TASK_TIMEOUT=1500

# ---- 素材与工程云端同步（OpenList）----
# 默认就是开的，而且下面这套是团队共用的值，拉下代码直接能用，不用改。
# storage/ 里的素材与工程会异步传上去，换一台机器打开时项目立刻就在，
# 素材等页面真要看它时才回拉。API Key 这类配置不在同步范围内。
#
# ⚠️ 这个账号密码随仓库分发，拿到代码的人都能读写这块存储。
#    要收紧就在自己的 .env 里覆盖（.env 不进仓库），或换个受限账号。
OPENLIST_SYNC_ENABLED=1
# 和 OpenList 同机跑的话改成 http://127.0.0.1:5244 会快很多
# （实测 3MB：本地 1.4s / 公网 11s）
OPENLIST_BASE_URL=https://openlist.apeiria.cc.cd
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=Autoword@773#
# 远端根目录，必须落在 OpenList 已挂载的存储下；设置页点「测试」会当场验它可不可写
OPENLIST_ROOT=/autoword/comic-studio
# 以下一般不用改：扫描间隔(秒) / 并发上传数 / 单次传输超时(秒) / 每个工程保留几个历史版本
OPENLIST_SCAN_INTERVAL=20
OPENLIST_WORKERS=2
OPENLIST_TIMEOUT=300
OPENLIST_KEEP_VERSIONS=20

# ---- l0veyou 网页生图（GPT Image 2）----
# 代码里已预置团队共用的登录令牌，留空即可用。要换成自己的就填这里（会覆盖预置值）。
# 注意：refresh_token 只能用一次，谁先续期谁就让其他人的预置令牌失效（预置值最多撑约 24 小时）。
L0VEYOU_ACCESS_TOKEN=
L0VEYOU_REFRESH_TOKEN=
L0VEYOU_IMAGE_MODEL=gpt-image-2
