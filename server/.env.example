# MiniMax AI 漫剧 Studio 环境配置
# 复制本文件为 .env 并填入真实密钥后重启后端服务

# MiniMax API（必填：剧本拆解 LLM 与 TTS 配音均依赖此密钥）
# 申请地址: https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 模型
LLM_MODEL=abab6.5s-chat
TTS_MODEL=speech-01-turbo
VIDEO_MODEL=video-01

# ComfyUI 生图服务（默认本机 8188；生图功能依赖 ComfyUI 在线）
COMFYUI_SERVER_URL=http://127.0.0.1:8188
# 留空则自动选择 ComfyUI 中第一个 SDXL/illustrious checkpoint
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT_SECONDS=240
