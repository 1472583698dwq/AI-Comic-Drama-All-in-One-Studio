{
  "id": "upscale_demo",
  "name": "视频超分演示",
  "kind": "video",
  "description": "示例代码节点：真实代码文件在 code/upscale_demo.py（透传输入视频并标注倍数）",
  "icon": "Boxes",
  "enabled": true,
